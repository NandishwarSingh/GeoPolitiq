
<%
  const REF_SOURCE_LABEL = {
    direct: { label: 'Direct / typed URL', icon: '🌐', color: '#888' },
    internal: { label: 'Internal navigation', icon: '🔗', color: '#7dd3fc' },
    search: { label: 'Search engines', icon: '🔍', color: '#4CAF50' },
    social: { label: 'Social media', icon: '💬', color: '#a78bfa' },
    news: { label: 'News / blogs', icon: '📰', color: '#fbbf24' },
    external: { label: 'Other external', icon: '↗️', color: '#f87171' },
    unknown: { label: 'Unknown', icon: '❓', color: '#666' },
  };
  const REJECT_LABEL = {
    'isbot-dictionary': 'isbot dictionary match',
    'pattern-match': 'Known scraper pattern',
    'ua-too-short': 'UA too short / empty',
    'missing-accept-language': 'No Accept-Language header',
    'missing-accept-encoding': 'No Accept-Encoding header',
    'no-html-accept': 'No text/html in Accept',
    'missing-sec-fetch': 'No Sec-Fetch-* headers',
    'chrome-without-sec-ch-ua': 'Claims Chrome but no Sec-CH-UA',
    'browser-version-ancient': 'Ancient browser version',
    'cold-hit-stale-ua': 'Cold direct hit + stale UA',
  };
%>
<div class="admin-analytics">
    <header class="admin-header">
        <h1>📊 Analytics</h1>
        <p class="admin-subtitle">Visitor statistics (bot traffic filtered)</p>
    </header>

    <div class="stats-grid">
        <div class="stat-card stat-today">
            <div class="stat-icon">📅</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.todayCount.toLocaleString() %>
                </span>
                <span class="stat-label">Today</span>
            </div>
        </div>

        <div class="stat-card stat-week">
            <div class="stat-icon">📆</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.weekCount.toLocaleString() %>
                </span>
                <span class="stat-label">This Week</span>
            </div>
        </div>

        <div class="stat-card stat-month">
            <div class="stat-icon">📅</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.monthCount.toLocaleString() %>
                </span>
                <span class="stat-label">This Month</span>
            </div>
        </div>

        <div class="stat-card stat-year">
            <div class="stat-icon">📈</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.yearCount.toLocaleString() %>
                </span>
                <span class="stat-label">This Year</span>
            </div>
        </div>

        <div class="stat-card stat-total">
            <div class="stat-icon">🌐</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.totalCount.toLocaleString() %>
                </span>
                <span class="stat-label">All Time</span>
            </div>
        </div>
    </div>

    <!-- Country Breakdown -->
    <div class="country-section">
        <h3>📍 Top Countries</h3>
        <% if (countryData.countries && countryData.countries.length> 0) { %>
            <div class="country-list">
                <% countryData.countries.forEach(function(c) { %>
                    <div class="country-row">
                        <span class="country-name">
                            <%= c.country %>
                        </span>
                        <div class="country-bar-container">
                            <div class="country-bar" style="width: <%= c.percentage %>%;"></div>
                        </div>
                        <span class="country-percent">
                            <%= c.percentage %>%
                        </span>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <p class="no-data">No country data yet. Visit from different locations to see breakdown.</p>
                <% } %>
    </div>

    <!-- Comparison Stats -->
    <div class="comparison-section">
        <h3>📊 Period Comparisons</h3>
        <div class="comparison-grid">
            <!-- Today vs Yesterday -->
            <div class="comparison-card">
                <div class="comparison-header">Today vs Yesterday</div>
                <div class="comparison-values">
                    <span class="comparison-current">
                        <%= stats.todayCount %>
                    </span>
                    <span class="comparison-vs">vs</span>
                    <span class="comparison-previous">
                        <%= stats.yesterdayCount %>
                    </span>
                </div>
                <div class="comparison-change <%= stats.dayChange >= 0 ? 'positive' : 'negative' %>">
                    <%= stats.dayChange>= 0 ? '↑' : '↓' %> <%= Math.abs(stats.dayChange) %>%
                </div>
            </div>

            <!-- This Week vs Last Week -->
            <div class="comparison-card">
                <div class="comparison-header">This Week vs Last Week</div>
                <div class="comparison-values">
                    <span class="comparison-current">
                        <%= stats.weekCount %>
                    </span>
                    <span class="comparison-vs">vs</span>
                    <span class="comparison-previous">
                        <%= stats.lastWeekCount %>
                    </span>
                </div>
                <div class="comparison-change <%= stats.weekChange >= 0 ? 'positive' : 'negative' %>">
                    <%= stats.weekChange>= 0 ? '↑' : '↓' %> <%= Math.abs(stats.weekChange) %>%
                </div>
            </div>

            <!-- This Month vs Last Month -->
            <div class="comparison-card">
                <div class="comparison-header">This Month vs Last Month</div>
                <div class="comparison-values">
                    <span class="comparison-current">
                        <%= stats.monthCount %>
                    </span>
                    <span class="comparison-vs">vs</span>
                    <span class="comparison-previous">
                        <%= stats.lastMonthCount %>
                    </span>
                </div>
                <div class="comparison-change <%= stats.monthChange >= 0 ? 'positive' : 'negative' %>">
                    <%= stats.monthChange>= 0 ? '↑' : '↓' %> <%= Math.abs(stats.monthChange) %>%
                </div>
            </div>

            <!-- This Year vs Last Year -->
            <div class="comparison-card">
                <div class="comparison-header">This Year vs Last Year</div>
                <div class="comparison-values">
                    <span class="comparison-current">
                        <%= stats.yearCount %>
                    </span>
                    <span class="comparison-vs">vs</span>
                    <span class="comparison-previous">
                        <%= stats.lastYearCount %>
                    </span>
                </div>
                <div class="comparison-change <%= stats.yearChange >= 0 ? 'positive' : 'negative' %>">
                    <%= stats.yearChange>= 0 ? '↑' : '↓' %> <%= Math.abs(stats.yearChange) %>%
                </div>
            </div>
        </div>
    </div>

    <!-- Notification Stats -->
    <div class="notification-section">
        <h3>🔔 Push Notifications</h3>
        <div class="notification-grid">
            <div class="notification-stat">
                <span class="notification-value">
                    <%= notificationStats.total %>
                </span>
                <span class="notification-label">Total Subscribers</span>
            </div>
            <div class="notification-stat">
                <span class="notification-value">
                    <%= notificationStats.active %>
                </span>
                <span class="notification-label">Active (30 days)</span>
            </div>
        </div>
        <% if (notificationStats.byCountry && notificationStats.byCountry.length> 0) { %>
            <div class="notification-countries">
                <span class="country-label">By Preference:</span>
                <% notificationStats.byCountry.forEach(function(c) { %>
                    <span class="country-badge">
                        <%= c.country %>: <%= c.count %>
                    </span>
                    <% }); %>
            </div>
            <% } %>
    </div>

    <!-- Popular Posts -->
    <div class="popular-section">
        <h3>🔥 Top 10 Posts</h3>
        <% if (popularPosts && popularPosts.length> 0) { %>
            <table class="popular-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Post Title</th>
                        <th>Views</th>
                    </tr>
                </thead>
                <tbody>
                    <% popularPosts.forEach(function(p, i) { %>
                        <tr>
                            <td class="rank">
                                <%= i + 1 %>
                            </td>
                            <td class="post-title">
                                <a href="<%= p.path %>" target="_blank">
                                    <%= p.title %>
                                </a>
                            </td>
                            <td class="views">
                                <%= p.views.toLocaleString() %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
            <% } else { %>
                <p class="no-data">No post views recorded yet.</p>
                <% } %>
    </div>

    <!-- Daily Views Table with CSV Export -->
    <div class="daily-section">
        <div class="section-header">
            <h3>📊 Daily Traffic (Last 30 Days)</h3>
            <a href="/admin/analytics/export" class="btn-export">📥 Download CSV</a>
        </div>
        <% if (dailyHistory && dailyHistory.length> 0) { %>
            <div class="table-scroll">
                <table class="daily-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Views</th>
                            <th>Growth</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% dailyHistory.forEach(function(day) { %>
                            <tr>
                                <td class="date">
                                    <%= day.date %>
                                </td>
                                <td class="views">
                                    <%= day.views.toLocaleString() %>
                                </td>
                                <td class="growth <%= day.growth >= 0 ? 'positive' : 'negative' %>">
                                    <%= day.growth>= 0 ? '↑' : '↓' %> <%= Math.abs(day.growth) %>%
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <p class="no-data">No daily data yet.</p>
                <% } %>
    </div>


    <!-- Referrers -->
    <div class="referrer-section">
        <h3>🔗 Referrers (last 7 days)</h3>
        <% if (referrerBreakdown && referrerBreakdown.length > 0) { %>
            <div class="referrer-grid">
                <% referrerBreakdown.forEach(function(r) {
                     const meta = REF_SOURCE_LABEL[r.source] || REF_SOURCE_LABEL.unknown; %>
                    <div class="referrer-card">
                        <span class="referrer-icon"><%= meta.icon %></span>
                        <div class="referrer-body">
                            <div class="referrer-row">
                                <span class="referrer-label"><%= meta.label %></span>
                                <span class="referrer-count"><%= r.count %></span>
                            </div>
                            <div class="referrer-bar">
                                <div class="referrer-bar-fill"
                                     style="width: <%= r.percentage %>%; background: <%= meta.color %>;"></div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
            <% if (topReferrers && topReferrers.length > 0) { %>
                <h4 class="sub-h">Top external referrers</h4>
                <table class="referrer-table">
                    <thead>
                        <tr><th>Source</th><th>URL</th><th>Hits</th></tr>
                    </thead>
                    <tbody>
                        <% topReferrers.forEach(function(r) {
                             const meta = REF_SOURCE_LABEL[r.source] || REF_SOURCE_LABEL.external; %>
                            <tr>
                                <td><span class="src-pill" style="background:<%= meta.color %>33;color:<%= meta.color %>;"><%= meta.icon %> <%= r.source %></span></td>
                                <td class="url-cell"><a href="<%= r.url %>" target="_blank" rel="noopener noreferrer"><%= r.url %></a></td>
                                <td class="num-cell"><%= r.count %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        <% } else { %>
            <p class="no-data">No referrer data yet — visit the site from a search engine or social link to populate this.</p>
        <% } %>
    </div>

    <!-- Bot filter -->
    <div class="reject-section">
        <h3>🤖 Bot filter (last 7 days)</h3>
        <p class="admin-subtitle">
            <%= totalRejections7d.toLocaleString() %> requests rejected before they reached the visitor count.
        </p>
        <% if (rejectionBreakdown && rejectionBreakdown.length > 0) { %>
            <div class="reject-summary">
                <% rejectionBreakdown.forEach(function(r) { %>
                    <div class="reject-pill">
                        <span class="reject-label"><%= REJECT_LABEL[r._id] || r._id %></span>
                        <span class="reject-count"><%= r.count %></span>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="no-data">No rejected requests in the last 7 days.</p>
        <% } %>

        <% if (recentRejections && recentRejections.length > 0) { %>
            <h4 class="sub-h">Recent rejections</h4>
            <div class="table-scroll">
                <table class="reject-table">
                    <thead>
                        <tr><th>When</th><th>Reason</th><th>Path</th><th>Country</th><th>User agent</th></tr>
                    </thead>
                    <tbody>
                        <% recentRejections.forEach(function(r) { %>
                            <tr>
                                <td class="when-cell"><%= new Date(r.timestamp).toLocaleString() %></td>
                                <td><span class="reason-pill"><%= REJECT_LABEL[r.reason] || r.reason %></span></td>
                                <td class="path-cell"><%= r.path %></td>
                                <td><%= r.country || '—' %></td>
                                <td class="ua-cell" title="<%= r.userAgent %>"><%= (r.userAgent || '').substring(0, 70) %><%= (r.userAgent || '').length > 70 ? '…' : '' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <div class="analytics-info">
        <h3>📋 About These Stats</h3>
        <ul>
            <li>✅ Only real human visitors are counted</li>
            <li>🤖 Bot traffic is automatically filtered</li>
            <li>🔄 Same IP within 4 hours = 1 visit</li>
            <li>🔒 IP addresses are hashed for privacy</li>
        </ul>
    </div>
</div>

<style>
    .admin-analytics {
        padding: 2rem;
    }

    .admin-header {
        margin-bottom: 2rem;
    }

    .admin-header h1 {
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
        color: #fff;
    }

    .admin-subtitle {
        color: #aaa;
        font-size: 0.9rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem;
        background: #252530;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        border-left: 4px solid #ddd;
    }

    .stat-today {
        border-left-color: #4CAF50;
    }

    .stat-week {
        border-left-color: #00BCD4;
    }

    .stat-month {
        border-left-color: #2196F3;
    }

    .stat-year {
        border-left-color: #FF9800;
    }

    .stat-total {
        border-left-color: #9C27B0;
    }

    .stat-icon {
        font-size: 1.75rem;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.2;
        color: #fff;
    }

    .stat-label {
        font-size: 0.75rem;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Country Breakdown */
    .country-section {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .country-section h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #fff;
    }

    .country-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .country-row {
        display: grid;
        grid-template-columns: 140px 1fr 50px;
        align-items: center;
        gap: 1rem;
    }

    .country-name {
        color: #fff;
        font-size: 0.9rem;
    }

    .country-bar-container {
        background: #1a1a2e;
        border-radius: 4px;
        height: 8px;
        overflow: hidden;
    }

    .country-bar {
        height: 100%;
        background: linear-gradient(90deg, #4CAF50, #2196F3);
        border-radius: 4px;
        transition: width 0.3s;
    }

    .country-percent {
        color: #aaa;
        font-size: 0.875rem;
        text-align: right;
    }

    .no-data {
        color: #666;
        font-size: 0.875rem;
        font-style: italic;
    }

    /* Comparison Section */
    .comparison-section {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .comparison-section h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #fff;
    }

    .comparison-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .comparison-card {
        background: #1a1a2e;
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
    }

    .comparison-header {
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
    }

    .comparison-values {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .comparison-current {
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
    }

    .comparison-vs {
        font-size: 0.75rem;
        color: #666;
    }

    .comparison-previous {
        font-size: 1.25rem;
        color: #888;
    }

    .comparison-change {
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
    }

    .comparison-change.positive {
        color: #4CAF50;
        background: rgba(76, 175, 80, 0.15);
    }

    .comparison-change.negative {
        color: #f44336;
        background: rgba(244, 67, 54, 0.15);
    }

    .analytics-info {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
    }

    .analytics-info h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #fff;
    }

    .analytics-info ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .analytics-info li {
        padding: 0.4rem 0;
        color: #aaa;
        font-size: 0.875rem;
    }

    /* Notification Section */
    .notification-section {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .notification-section h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #fff;
    }

    .notification-grid {
        display: flex;
        gap: 2rem;
        margin-bottom: 1rem;
    }

    .notification-stat {
        display: flex;
        flex-direction: column;
    }

    .notification-value {
        font-size: 2rem;
        font-weight: 700;
        color: #fff;
    }

    .notification-label {
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
    }

    .notification-countries {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .country-label {
        font-size: 0.8rem;
        color: #888;
    }

    .country-badge {
        background: #1a1a2e;
        color: #aaa;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
    }

    /* Popular Posts Section */
    .popular-section {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .popular-section h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #fff;
    }

    .popular-table {
        width: 100%;
        border-collapse: collapse;
    }

    .popular-table th {
        text-align: left;
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #666;
        padding: 0.5rem;
        border-bottom: 1px solid #333;
    }

    .popular-table td {
        padding: 0.75rem 0.5rem;
        border-bottom: 1px solid #2a2a3a;
    }

    .popular-table .rank {
        width: 40px;
        font-weight: 700;
        color: #888;
    }

    .popular-table .post-title a {
        color: #fff;
        text-decoration: none;
    }

    .popular-table .post-title a:hover {
        color: #3b82f6;
    }

    .popular-table .views {
        text-align: right;
        color: #4CAF50;
        font-weight: 600;
    }

    /* Daily Traffic Section */
    .daily-section {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .section-header h3 {
        font-size: 1rem;
        color: #fff;
        margin: 0;
    }

    .btn-export {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.2s;
    }

    .btn-export:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }

    .table-scroll {
        max-height: 400px;
        overflow-y: auto;
    }

    .daily-table {
        width: 100%;
        border-collapse: collapse;
    }

    .daily-table th {
        position: sticky;
        top: 0;
        background: #252530;
        text-align: left;
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #666;
        padding: 0.5rem;
        border-bottom: 1px solid #333;
    }

    .daily-table td {
        padding: 0.6rem 0.5rem;
        border-bottom: 1px solid #2a2a3a;
        font-size: 0.9rem;
    }

    .daily-table .date {
        color: #fff;
    }

    .daily-table .views {
        color: #aaa;
    }

    .daily-table .growth {
        font-weight: 600;
        text-align: right;
    }

    .daily-table .growth.positive {
        color: #4CAF50;
    }

    .daily-table .growth.negative {
        color: #f44336;
    }

    .daily-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.03);
    }

    /* ---- Referrer widget ---- */
    .referrer-section,
    .reject-section {
        margin-top: 2rem;
        padding: 1.5rem;
        background: #1f1f28;
        border-radius: 12px;
        border: 1px solid #2a2a3a;
    }
    .referrer-section h3,
    .reject-section h3 {
        font-size: 1rem;
        color: #fff;
        margin: 0 0 1rem;
    }
    .referrer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.75rem;
    }
    .referrer-card {
        display: flex;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        background: #252530;
        border-radius: 8px;
        border: 1px solid #2a2a3a;
    }
    .referrer-icon {
        font-size: 1.4rem;
        line-height: 1;
    }
    .referrer-body { flex: 1; min-width: 0; }
    .referrer-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;

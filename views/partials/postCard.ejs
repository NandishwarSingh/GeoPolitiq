<article class="post-card">
    <a href="/post/<%= post.slug %>" class="post-card-link">
        <% if (post.featuredImage) { %>
            <div class="post-card-image" style="background-image: url('<%= post.featuredImage %>')"></div>
            <% } %>

                <div class="post-card-content">
                    <h3 class="post-card-title">
                        <%= post.title %>
                    </h3>
                    <p class="post-card-tldr">
                        <%= post.tldr %>
                    </p>

                    <div class="post-card-meta">
                        <div class="post-card-tags">
                            <% if (post.tags && post.tags.length> 0) { %>
                                <% post.tags.slice(0, 3).forEach(function(tag) { %>
                                    <span class="tag">
                                        <%= tag %>
                                    </span>
                                    <% }); %>
                                        <% } %>
                        </div>
                        <time class="post-card-time" datetime="<%= post.publishedAt || post.createdAt %>">
                            <%= post.relativeTime || 'Recently' %>
                        </time>
                    </div>
                </div>
    </a>
</article>
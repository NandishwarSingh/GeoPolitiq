<div class="admin-analytics">
    <header class="admin-header">
        <h1>📊 Analytics</h1>
        <p class="admin-subtitle">Visitor statistics (bot traffic filtered)</p>
    </header>

    <div class="stats-grid">
        <div class="stat-card stat-today">
            <div class="stat-icon">📅</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.todayCount.toLocaleString() %>
                </span>
                <span class="stat-label">Today</span>
            </div>
        </div>

        <div class="stat-card stat-week">
            <div class="stat-icon">📆</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.weekCount.toLocaleString() %>
                </span>
                <span class="stat-label">This Week</span>
            </div>
        </div>

        <div class="stat-card stat-month">
            <div class="stat-icon">📅</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.monthCount.toLocaleString() %>
                </span>
                <span class="stat-label">This Month</span>
            </div>
        </div>

        <div class="stat-card stat-year">
            <div class="stat-icon">📈</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.yearCount.toLocaleString() %>
                </span>
                <span class="stat-label">This Year</span>
            </div>
        </div>

        <div class="stat-card stat-total">
            <div class="stat-icon">🌐</div>
            <div class="stat-content">
                <span class="stat-value">
                    <%= stats.totalCount.toLocaleString() %>
                </span>
                <span class="stat-label">All Time</span>
            </div>
        </div>
    </div>

    <!-- Country Breakdown -->
    <div class="country-section">
        <h3>📍 Top Countries</h3>
        <% if (countryData.countries && countryData.countries.length> 0) { %>
            <div class="country-list">
                <% countryData.countries.forEach(function(c) { %>
                    <div class="country-row">
                        <span class="country-name">
                            <%= c.country %>
                        </span>
                        <div class="country-bar-container">
                            <div class="country-bar" style="width: <%= c.percentage %>%;"></div>
                        </div>
                        <span class="country-percent">
                            <%= c.percentage %>%
                        </span>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <p class="no-data">No country data yet. Visit from different locations to see breakdown.</p>
                <% } %>
    </div>

    <!-- Comparison Stats -->
    <div class="comparison-section">
        <h3>📊 Period Comparisons</h3>
        <div class="comparison-grid">
            <!-- Today vs Yesterday -->
            <div class="comparison-card">
                <div class="comparison-header">Today vs Yesterday</div>
                <div class="comparison-values">
                    <span class="comparison-current">
                        <%= stats.todayCount %>
                    </span>
                    <span class="comparison-vs">vs</span>
                    <span class="comparison-previous">
                        <%= stats.yesterdayCount %>
                    </span>
                </div>
                <div class="comparison-change <%= stats.dayChange >= 0 ? 'positive' : 'negative' %>">
                    <%= stats.dayChange>= 0 ? '↑' : '↓' %> <%= Math.abs(stats.dayChange) %>%
                </div>
            </div>

            <!-- This Week vs Last Week -->
            <div class="comparison-card">
                <div class="comparison-header">This Week vs Last Week</div>
                <div class="comparison-values">
                    <span class="comparison-current">
                        <%= stats.weekCount %>
                    </span>
                    <span class="comparison-vs">vs</span>
                    <span class="comparison-previous">
                        <%= stats.lastWeekCount %>
                    </span>
                </div>
                <div class="comparison-change <%= stats.weekChange >= 0 ? 'positive' : 'negative' %>">
                    <%= stats.weekChange>= 0 ? '↑' : '↓' %> <%= Math.abs(stats.weekChange) %>%
                </div>
            </div>

            <!-- This Month vs Last Month -->
            <div class="comparison-card">
                <div class="comparison-header">This Month vs Last Month</div>
                <div class="comparison-values">
                    <span class="comparison-current">
                        <%= stats.monthCount %>
                    </span>
                    <span class="comparison-vs">vs</span>
                    <span class="comparison-previous">
                        <%= stats.lastMonthCount %>
                    </span>
                </div>
                <div class="comparison-change <%= stats.monthChange >= 0 ? 'positive' : 'negative' %>">
                    <%= stats.monthChange>= 0 ? '↑' : '↓' %> <%= Math.abs(stats.monthChange) %>%
                </div>
            </div>

            <!-- This Year vs Last Year -->
            <div class="comparison-card">
                <div class="comparison-header">This Year vs Last Year</div>
                <div class="comparison-values">
                    <span class="comparison-current">
                        <%= stats.yearCount %>
                    </span>
                    <span class="comparison-vs">vs</span>
                    <span class="comparison-previous">
                        <%= stats.lastYearCount %>
                    </span>
                </div>
                <div class="comparison-change <%= stats.yearChange >= 0 ? 'positive' : 'negative' %>">
                    <%= stats.yearChange>= 0 ? '↑' : '↓' %> <%= Math.abs(stats.yearChange) %>%
                </div>
            </div>
        </div>
    </div>

    <div class="analytics-info">
        <h3>📋 About These Stats</h3>
        <ul>
            <li>✅ Only real human visitors are counted</li>
            <li>🤖 Bot traffic is automatically filtered</li>
            <li>🔄 Same IP within 4 hours = 1 visit</li>
            <li>🔒 IP addresses are hashed for privacy</li>
        </ul>
    </div>
</div>

<style>
    .admin-analytics {
        padding: 2rem;
    }

    .admin-header {
        margin-bottom: 2rem;
    }

    .admin-header h1 {
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
        color: #fff;
    }

    .admin-subtitle {
        color: #aaa;
        font-size: 0.9rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem;
        background: #252530;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        border-left: 4px solid #ddd;
    }

    .stat-today {
        border-left-color: #4CAF50;
    }

    .stat-week {
        border-left-color: #00BCD4;
    }

    .stat-month {
        border-left-color: #2196F3;
    }

    .stat-year {
        border-left-color: #FF9800;
    }

    .stat-total {
        border-left-color: #9C27B0;
    }

    .stat-icon {
        font-size: 1.75rem;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.2;
        color: #fff;
    }

    .stat-label {
        font-size: 0.75rem;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Country Breakdown */
    .country-section {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .country-section h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #fff;
    }

    .country-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .country-row {
        display: grid;
        grid-template-columns: 140px 1fr 50px;
        align-items: center;
        gap: 1rem;
    }

    .country-name {
        color: #fff;
        font-size: 0.9rem;
    }

    .country-bar-container {
        background: #1a1a2e;
        border-radius: 4px;
        height: 8px;
        overflow: hidden;
    }

    .country-bar {
        height: 100%;
        background: linear-gradient(90deg, #4CAF50, #2196F3);
        border-radius: 4px;
        transition: width 0.3s;
    }

    .country-percent {
        color: #aaa;
        font-size: 0.875rem;
        text-align: right;
    }

    .no-data {
        color: #666;
        font-size: 0.875rem;
        font-style: italic;
    }

    /* Comparison Section */
    .comparison-section {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .comparison-section h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #fff;
    }

    .comparison-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .comparison-card {
        background: #1a1a2e;
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
    }

    .comparison-header {
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
    }

    .comparison-values {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .comparison-current {
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
    }

    .comparison-vs {
        font-size: 0.75rem;
        color: #666;
    }

    .comparison-previous {
        font-size: 1.25rem;
        color: #888;
    }

    .comparison-change {
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
    }

    .comparison-change.positive {
        color: #4CAF50;
        background: rgba(76, 175, 80, 0.15);
    }

    .comparison-change.negative {
        color: #f44336;
        background: rgba(244, 67, 54, 0.15);
    }

    .analytics-info {
        background: #252530;
        padding: 1.5rem;
        border-radius: 8px;
    }

    .analytics-info h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #fff;
    }

    .analytics-info ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .analytics-info li {
        padding: 0.4rem 0;
        color: #aaa;
        font-size: 0.875rem;
    }
</style>
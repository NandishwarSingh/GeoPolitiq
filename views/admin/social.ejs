<div class="admin-social">
    <header class="dashboard-header">
        <div>
            <h1>📡 Social Reposts</h1>
            <p class="page-subtitle">
                Auto-distribution to social platforms with backlinks.
                <% if (dryRun) { %><span class="dry-pill">DRY RUN</span><% } %>
            </p>
        </div>
    </header>

    <% if (flashSuccess) { %>
        <div class="flash flash-ok">✅ <%= flashSuccess %></div>
    <% } %>
    <% if (flashError) { %>
        <div class="flash flash-err">❌ <%= flashError %></div>
    <% } %>

    <!-- Configured platforms -->
    <section class="section">
        <h3 class="section-title">Configured platforms (<%= configured.length %>)</h3>
        <% if (configured.length === 0) { %>
            <p class="no-data">No <code>SOCIAL_TARGETS</code> configured. Set the env var to enable reposting.</p>
        <% } else { %>
            <div class="config-grid">
                <% configured.forEach(function(c) { %>
                    <div class="config-card">
                        <span class="platform-name"><%= c.platform %></span>
                        <% if (c.subPlatform) { %><span class="sub-platform">@<%= c.subPlatform %></span><% } %>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </section>

    <!-- Per-platform stats -->
    <section class="section">
        <div class="section-bar">
            <h3 class="section-title">Per-platform stats <span class="muted">· last 30 days</span></h3>
            <form method="POST" action="/admin/social/drain" style="display:inline">
                <button type="submit" class="btn btn-secondary btn-sm">⚙️ Run worker tick now</button>
            </form>
        </div>
        <% if (stats.length === 0) { %>
            <p class="no-data">No reposts yet.</p>
        <% } else { %>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Platform</th>
                            <th class="num">Total</th>
                            <th class="num">Success</th>
                            <th class="num">Pending</th>
                            <th class="num">Failed</th>
                            <th class="num">Skipped</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% stats.forEach(function(s) { %>
                            <tr>
                                <td class="platform-cell"><%= s.platform %></td>
                                <td class="num"><%= s.total %></td>
                                <td class="num ok"><%= s.statuses.success || 0 %></td>
                                <td class="num"><%= s.statuses.pending || 0 %></td>
                                <td class="num bad"><%= s.statuses.failed || 0 %></td>
                                <td class="num muted"><%= s.statuses.skipped || 0 %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <!-- Recent activity -->
    <section class="section">
        <h3 class="section-title">Recent activity <span class="muted">· last 50</span></h3>
        <% if (recent.length === 0) { %>
            <p class="no-data">No tasks recorded yet.</p>
        <% } else { %>
            <div class="table-wrap recent-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Platform</th>
                            <th>Post</th>
                            <th>Status</th>
                            <th class="num">Tries</th>
                            <th>Result</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recent.forEach(function(r) { %>
                            <tr>
                                <td class="when"><%= new Date(r.createdAt).toLocaleString() %></td>
                                <td class="platform-cell"><%= r.platform %><% if (r.subPlatform) { %>@<%= r.subPlatform %><% } %></td>
                                <td class="slug"><a href="/post/<%= r.postSlug %>" target="_blank"><%= r.postSlug.substring(0, 36) %><%= r.postSlug.length > 36 ? '…' : '' %></a></td>
                                <td><span class="status-pill status-<%= r.status %>"><%= r.status %></span></td>
                                <td class="num"><%= r.attempts %></td>
                                <td class="result">
                                    <% if (r.remoteUrl && r.remoteUrl !== 'about:blank') { %>
                                        <a href="<%= r.remoteUrl %>" target="_blank">↗ view</a>
                                    <% } else if (r.errorMessage) { %>
                                        <span class="err" title="<%= r.errorCategory %>"><%= r.errorMessage.substring(0, 60) %><%= r.errorMessage.length > 60 ? '…' : '' %></span>
                                    <% } else { %>
                                        <span class="muted">—</span>
                                    <% } %>
                                </td>
                                <td class="actions">
                                    <% if (r.status === 'failed' || r.status === 'paused') { %>
                                        <form method="POST" action="/admin/social/retry/<%= r._id %>" style="display:inline">
                                            <button type="submit" class="btn btn-sm btn-secondary">retry</button>
                                        </form>
                                    <% } %>
                                    <% if (r.status === 'pending' || r.status === 'paused') { %>
                                        <form method="POST" action="/admin/social/skip/<%= r._id %>" style="display:inline">
                                            <button type="submit" class="btn btn-sm btn-warn">skip</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>
</div>

<style>
    /* Match the admin palette exactly: navbar #1a1a2e/#16213e, cards #252530,
       borders #2a2a3a, accent blue #3b82f6, status colors from analytics.ejs */

    .admin-social { padding: 28px 32px 64px; max-width: 1280px; margin: 0 auto; }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }
    .dashboard-header h1 { font-size: 1.6rem; color: #fff; margin: 0 0 4px; font-weight: 600; }
    .page-subtitle { color: #aaa; font-size: 0.85rem; margin: 0; }
    .dry-pill {
        display: inline-block;
        margin-left: 8px;
        padding: 2px 8px;
        background: #2a2620;
        color: #fbbf24;
        border: 1px solid #4a3a1c;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    /* Flash messages */
    .flash {
        padding: 10px 14px;
        border-radius: 6px;
        margin: 12px 0 0;
        font-size: 0.85rem;
        border: 1px solid transparent;
    }
    .flash-ok  { background: #1a2e1f; color: #4CAF50; border-color: #2a4a35; }
    .flash-err { background: #2e1f1f; color: #ef4444; border-color: #4a2c2c; }

    /* Sections */
    .section { margin: 28px 0; }
    .section-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }
    .section-title { font-size: 0.95rem; color: #fff; margin: 0 0 12px; font-weight: 600; }
    .section-title .muted { font-weight: 400; color: #777; }
    .no-data { color: #777; font-size: 0.85rem; padding: 24px; text-align: center; background: #1f1f28; border: 1px dashed #2a2a3a; border-radius: 8px; }
    code { background: #1f1f28; padding: 2px 6px; border-radius: 4px; font-size: 0.85em; color: #ddd; }

    /* Configured platform tiles */
    .config-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 10px;
    }
    .config-card {
        padding: 12px 14px;
        background: #252530;
        border: 1px solid #2a2a3a;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        transition: border-color 0.2s;
    }
    .config-card:hover { border-color: #3b82f6; }
    .platform-name { font-weight: 600; color: #fff; text-transform: capitalize; font-size: 0.9rem; }
    .sub-platform { font-size: 0.72rem; color: #888; font-family: ui-monospace, SFMono-Regular, monospace; }

    /* Tables */
    .table-wrap {
        background: #252530;
        border: 1px solid #2a2a3a;
        border-radius: 8px;
        overflow: hidden;
    }
    .recent-wrap { max-height: 600px; overflow-y: auto; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th {
        text-align: left;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #777;
        padding: 10px 12px;
        background: #1f1f28;
        border-bottom: 1px solid #2a2a3a;
        position: sticky;
        top: 0;
        z-index: 1;
        font-weight: 600;
    }
    .data-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #2a2a3a;
        font-size: 0.85rem;
        color: #ddd;
    }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: rgba(255, 255, 255, 0.02); }

    .num { text-align: right; font-variant-numeric: tabular-nums; }
    .ok    { color: #4CAF50; font-weight: 600; }
    .bad   { color: #ef4444; font-weight: 600; }
    .err   { color: #ef4444; }
    .muted { color: #777; }
    .platform-cell { text-transform: capitalize; }
    .when   { color: #888; font-size: 0.78rem; white-space: nowrap; }
    .slug a { color: #60a5fa; text-decoration: none; font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.78rem; }
    .slug a:hover { text-decoration: underline; }
    .result { max-width: 320px; }
    .result a { color: #60a5fa; text-decoration: none; }
    .result a:hover { text-decoration: underline; }
    .actions { white-space: nowrap; text-align: right; }

    /* Status pills (consistent with analytics.ejs colors) */
    .status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: capitalize;
        letter-spacing: 0.02em;
    }
    .status-pending   { background: #2a2a3a; color: #aaa; border: 1px solid #383848; }
    .status-in_flight { background: #1d2a3e; color: #60a5fa; border: 1px solid #2a3e5e; }
    .status-success   { background: #1a2e1f; color: #4CAF50; border: 1px solid #2a4a35; }
    .status-failed    { background: #2e1f1f; color: #ef4444; border: 1px solid #4a2c2c; }
    .status-skipped   { background: #252530; color: #777; border: 1px solid #2a2a3a; }
    .status-paused    { background: #2a2620; color: #fbbf24; border: 1px solid #4a3a1c; }

    /* Buttons — match admin .btn family */
    .btn {
        display: inline-block;
        padding: 7px 14px;
        border: 1px solid #2a2a3a;
        background: #252530;
        color: #ddd;
        border-radius: 6px;
        cursor: pointer;
        font: inherit;
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.2s;
        text-decoration: none;
    }
    .btn:hover     { background: #2a2a3e; border-color: #3b82f6; color: #fff; }
    .btn-secondary { background: #252530; }
    .btn-warn      { color: #fbbf24; border-color: #4a3a1c; background: #2a2620; }
    .btn-warn:hover{ background: #3a2f20; border-color: #fbbf24; color: #fff; }
    .btn-sm        { padding: 4px 10px; font-size: 0.74rem; border-radius: 4px; }
</style>

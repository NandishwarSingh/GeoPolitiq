<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Settings - Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        .settings-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 2rem;
        }

        .settings-card {
            background: var(--color-surface, #1a1a2e);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .settings-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--color-text, #fff);
        }

        .model-grid {
            display: grid;
            gap: 1rem;
        }

        .model-option {
            display: flex;
            align-items: center;
            padding: 1.25rem;
            background: var(--color-bg, #0f0f1a);
            border: 2px solid transparent;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .model-option:hover {
            border-color: var(--color-primary, #6366f1);
        }

        .model-option.selected {
            border-color: var(--color-primary, #6366f1);
            background: rgba(99, 102, 241, 0.1);
        }

        .model-radio {
            width: 20px;
            height: 20px;
            margin-right: 1rem;
            accent-color: var(--color-primary, #6366f1);
        }

        .model-info {
            flex: 1;
        }

        .model-name {
            font-weight: 600;
            font-size: 1.1rem;
            color: var(--color-text, #fff);
        }

        .model-desc {
            font-size: 0.9rem;
            color: var(--color-text-muted, #888);
            margin-top: 0.25rem;
        }

        .model-price {
            text-align: right;
        }

        .model-cost {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--color-success, #10b981);
        }

        .model-cost.free {
            color: var(--color-success, #10b981);
        }

        .model-cost-label {
            font-size: 0.75rem;
            color: var(--color-text-muted, #888);
        }

        .save-btn {
            width: 100%;
            padding: 1rem;
            background: var(--color-primary, #6366f1);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

        .save-btn:hover {
            background: #4f46e5;
        }

        .current-status {
            display: flex;
            justify-content: space-between;
            padding: 1rem;
            background: var(--color-bg, #0f0f1a);
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }

        .status-item {
            text-align: center;
        }

        .status-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--color-primary, #6366f1);
        }

        .status-label {
            font-size: 0.75rem;
            color: var(--color-text-muted, #888);
            text-transform: uppercase;
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.2);
            border: 1px solid #10b981;
            color: #10b981;
        }

        .alert-info {
            background: rgba(99, 102, 241, 0.2);
            border: 1px solid #6366f1;
            color: #a5b4fc;
        }
    </style>
</head>

<body>
    <div class="settings-container">
        <a href="/admin"
            style="color: var(--color-primary); text-decoration: none; margin-bottom: 1rem; display: inline-block;">←
            Back to Dashboard</a>

        <h1 style="font-size: 2rem; margin-bottom: 2rem;">AI Settings</h1>

        <% if (typeof success !=='undefined' && success) { %>
            <div class="alert alert-success">✅ Settings saved successfully!</div>
            <% } %>

                <div class="settings-card">
                    <h2 class="settings-title">Current Status</h2>
                    <div class="current-status">
                        <div class="status-item">
                            <div class="status-value">
                                <%= currentModel.name.split(' ')[0] %></div>
                    <div class="status-label">Current Model</div>
                </div>
                <div class="status-item">
                    <div class="status-value">₹<%= currentModel.dailyCostINR %></div>
                    <div class="status-label">Est. Daily Cost</div>
                </div>
                <div class="status-item">
                    <div class="status-value"><%= schedulerEnabled ? ' ON' : 'OFF' %>
                            </div>
                            <div class="status-label">Scheduler</div>
                        </div>
                    </div>
                </div>

                <form action="/admin/settings" method="POST">
                    <div class="settings-card">
                        <h2 class="settings-title">Select AI Model</h2>

                        <div class="alert alert-info">
                            💡 All models have web search capability for real-time news
                        </div>

                        <div class="model-grid">
                            <% Object.entries(models).forEach(([key, model])=> { %>
                                <label class="model-option <%= selectedModel === key ? 'selected' : '' %>">
                                    <input type="radio" name="model" value="<%= key %>" class="model-radio"
                                        <%=selectedModel===key ? 'checked' : '' %>>
                                    <div class="model-info">
                                        <div class="model-name">
                                            <%= model.name %>
                                        </div>
                                        <div class="model-desc">
                                            <%= model.description %>
                                        </div>
                                    </div>
                                    <div class="model-price">
                                        <div class="model-cost <%= model.dailyCostINR === 0 ? 'free' : '' %>">
                                            <%= model.dailyCostINR===0 ? 'FREE' : '₹' + model.dailyCostINR %>
                                        </div>
                                        <div class="model-cost-label">per day</div>
                                    </div>
                                </label>
                                <% }); %>
                        </div>
                    </div>

                    <button type="submit" class="save-btn">💾 Save Settings</button>
                </form>
    </div>

    <script>
        // Highlight selected option
        document.querySelectorAll('.model-option').forEach(option => {
            option.addEventListener('click', () => {
                document.querySelectorAll('.model-option').forEach(o => o.classList.remove('selected'));
                option.classList.add('selected');
            });
        });
    </script>
</body>

</html>
<div class="admin-dashboard">
    <header class="dashboard-header">
        <h1>Dashboard</h1>
        <a href="/admin/posts/new" class="btn btn-primary">
            + New Post
        </a>
    </header>

    <div class="quick-links">
        <a href="/admin/ai" class="quick-link-tile">
            <span class="ql-icon">🤖</span>
            <span class="ql-body">
                <strong>AI Generation</strong>
                <span>Trigger a new batch + view recent runs</span>
            </span>
        </a>
        <a href="/admin/analytics" class="quick-link-tile">
            <span class="ql-icon">📊</span>
            <span class="ql-body">
                <strong>Analytics</strong>
                <span>Visitors, referrers, popular posts, bot filter</span>
            </span>
        </a>
        <a href="/admin/social" class="quick-link-tile">
            <span class="ql-icon">📡</span>
            <span class="ql-body">
                <strong>Social Reposts</strong>
                <span>Auto-distribution + per-platform stats</span>
            </span>
        </a>
    </div>

    <style>
        .quick-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 12px;
            margin: 16px 0 28px;
        }
        .quick-link-tile {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            background: #252530;
            border: 1px solid #2a2a3a;
            border-radius: 10px;
            text-decoration: none;
            color: #ddd;
            transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
        }
        .quick-link-tile:hover {
            border-color: #3b82f6;
            background: #2a2a3e;
            transform: translateY(-1px);
        }
        .ql-icon { font-size: 1.6rem; line-height: 1; }
        .ql-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
        .ql-body strong { color: #fff; font-size: 0.95rem; font-weight: 600; }
        .ql-body span { color: #888; font-size: 0.8rem; }
    </style>

    <% if (posts && posts.length> 0) { %>
        <div class="posts-table-container">
            <table class="posts-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Tags</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% posts.forEach(function(post) { %>
                        <tr>
                            <td class="post-title-cell">
                                <a href="/post/<%= post.slug %>" target="_blank" class="post-title-link">
                                    <%= post.title %>
                                        <span class="external-icon">↗</span>
                                </a>
                            </td>
                            <td>
                                <span class="status-badge status-<%= post.status %>">
                                    <%= post.status %>
                                </span>
                            </td>
                            <td class="tags-cell">
                                <% if (post.tags && post.tags.length> 0) { %>
                                    <% post.tags.slice(0, 3).forEach(function(tag) { %>
                                        <span class="tag tag-small">
                                            <%= tag %>
                                        </span>
                                        <% }); %>
                                            <% if (post.tags.length> 3) { %>
                                                <span class="tag-more">+<%= post.tags.length - 3 %></span>
                                                <% } %>
                                                    <% } else { %>
                                                        <span class="no-tags">—</span>
                                                        <% } %>
                            </td>
                            <td class="date-cell">
                                <%= new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short' ,
                                    day: 'numeric' , year: 'numeric' }) %>
                            </td>
                            <td class="actions-cell">
                                <a href="/admin/posts/<%= post._id %>/edit" class="btn btn-small btn-secondary">
                                    Edit
                                </a>
                                <form action="/admin/posts/<%= post._id %>?_method=DELETE" method="POST"
                                    class="delete-form"
                                    onsubmit="return confirm('Are you sure you want to delete this post?')">
                                    <button type="submit" class="btn btn-small btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-content">
                    <span class="empty-icon">📝</span>
                    <h2>No posts yet</h2>
                    <p>Create your first post to get started.</p>
                    <a href="/admin/posts/new" class="btn btn-primary">Create First Post</a>
                </div>
            </div>
            <% } %>
</div>